{
  "identifier": "default",
  "description": "Default permissions for the application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-appdata-read-recursive",
